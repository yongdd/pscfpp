BdSimulator{
   seed            5
   LMBdStep{
      mobility     0.02
   }
   LrAmCompressor{
      epsilon      1.0e-8
      maxItr       200
      maxHist      20
      verbose      0
      errorType    rms
   }
   LinearRamp{
      nParameter   1
      parameters[
         cell_param  0  0.4
      ]
   }
   AnalyzerManager{
      baseInterval    1
      TrajectoryWriter{
         interval          1
         outputFileName    out/FtsCellRamp_trajectory
      }
      ConcentrationWriter{
         interval          1
         outputFileName    out/FtsCellRamp_concentration
      }
   }
}
