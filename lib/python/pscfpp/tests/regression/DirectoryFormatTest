#!/usr/bin/env python3
"""Directory text and XML representations compose files and nested directories."""
from pathlib import Path
import tempfile
import unittest
import xml.etree.ElementTree as ET
from pscfpp.file import Directory


class DirectoryFormatTest(unittest.TestCase):
    def test_empty_directory(self):
        with tempfile.TemporaryDirectory(prefix='directory-format-') as directory:
            d = Directory(directory)
            self.assertEqual(str(d), directory + '\n')
            self.assertEqual(repr(d), directory + '\n')
            node = ET.fromstring(d.xml())
            self.assertEqual(node.attrib, {'path': directory})
            self.assertEqual(list(node), [])
            self.assertEqual(d.filenames('input', recursive=False), [])

    def test_nested_files_and_xml_write(self):
        with tempfile.TemporaryDirectory(prefix='directory-format-') as directory:
            root = Path(directory)
            (root / 'input').write_text('abc')
            child = root / 'child'
            child.mkdir()
            (child / 'nested').write_text('xyz')
            d = Directory(directory)
            expected = [directory, str(root / 'input'), str(child), str(child / 'nested')]
            self.assertEqual(str(d).splitlines(), expected)
            self.assertEqual(repr(d).splitlines(), expected)
            node = ET.fromstring(d.xml('  '))
            self.assertEqual(node.find('File').get('path'), str(root / 'input'))
            self.assertEqual(node.find('Directory/File').get('path'), str(child / 'nested'))
            self.assertEqual(d.filenames('input', recursive=False), [str(root / 'input')])
            dest = root / 'listing.xml'
            d.write(str(dest))
            self.assertEqual(dest.read_text(), d.xml())

    def test_difference_text(self):
        with tempfile.TemporaryDirectory(prefix='directory-format-') as directory:
            before = Directory(directory)
            path = Path(directory) / 'added'
            path.write_text('abc')
            after = Directory(directory)
            self.assertEqual(before.diff(before), '')
            self.assertEqual(after.diff(before), '> ' + after.files[str(path)].xml() + '\n')
            self.assertEqual(before.diff(after), '< ' + after.files[str(path)].xml() + '\n')


if __name__ == '__main__':
    unittest.main(verbosity=2)
