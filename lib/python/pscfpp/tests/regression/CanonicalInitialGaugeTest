#!/usr/bin/env python3
import argparse


import math


from pathlib import Path


import re


import shutil


import subprocess


import tempfile


SOURCE = Path(__file__).resolve().parents[5]


def execute(root, name, program, param, field, command):
    work = root / name
    work.mkdir()
    (work / 'param').write_text(param)
    if field is not None:
        (work / 'w').write_text(field)
    (work / 'command').write_text(command)
    exe = shutil.which('pscf_' + program)
    if exe is None:
        exe = str(SOURCE / 'bin' / ('pscf_' + program))
    args = [exe] + ([] if program == '1d' else ['-d', '1'])
    args += ['-p', 'param', '-c', 'command']
    run = subprocess.run(args, cwd=work, capture_output=True, text=True,
                         timeout=60)
    log = run.stdout + run.stderr
    (work / 'log').write_text(log)
    return work, run.returncode, log


def mixture(phi, solvent=False):
    minor = ('Solvent{ monomerId 1 size 1 phi %.17g }' % phi if solvent else
             'Polymer{ type linear nBlock 1 blocks[ 1 1 ] phi %.17g }' % phi)
    return '''Mixture{
 nMonomer 2 monomers[ 1 1 ]
 nPolymer %d nSolvent %d
 Polymer{ type linear nBlock 1 blocks[ 0 1 ] phi %.17g }
 %s
 ds .05
}
''' % (1 if solvent else 2, 1 if solvent else 0, 1-phi, minor)


def basis(shift, amplitude):
    return '''format 1 0
dim
1
crystal_system
lamellar
N_cell_param
1
cell_param
1
group_name
P_-1
N_monomer
2
N_basis
5
%.17g %.17g 0 1
%.17g %.17g 1 2
0 0 2 2
0 0 3 2
0 0 4 1
''' % (shift, shift, amplitude, -amplitude)


def canonical_gauge(root, program):
    for iterator in ['AmIteratorBasis', 'AmIteratorGrid']:
        param = ('System{\n' + mixture(.5) +
                 'Interaction{ chi( 0 1 1 ) }\n'
                 'Domain{ mesh 8 lattice lamellar groupName P_-1 }\n' +
                 iterator + '{ epsilon 1e-8 maxItr 1 maxHist 5 '
                 'verbose 3 isFlexible 0 }\n}\n')
        errors = []
        for amplitude in [.4, 0.0]:
            for shift in [0., 1e9]:
                name = '%s_%s_a%s_g%s' % (program, iterator, amplitude, shift)
                _, rc, log = execute(root, name, program, param,
                                    basis(shift, amplitude),
                                    'READ_W_BASIS w\nITERATE\nFINISH\n')
                expected_rc = 1 if amplitude else 0
                assert rc == expected_rc, (name, rc, log[-1000:])
                if amplitude:
                    assert 'Converged' not in log, name
                    residual = float(re.search(r'Max Residual\s*=\s*(\S+)', log)[1])
                    relative = float(re.search(r'Relative Norm\s*=\s*(\S+)', log)[1])
                    assert residual > .3 and relative > .1, (name, residual, relative)
                    errors.append(relative)
        assert abs(errors[0]-errors[1]) < 1e-6, (iterator, errors)
    print(program + ': canonical initial gauge and homogeneous controls passed')


def run(root, programs):
    root.mkdir(parents=True, exist_ok=True)
    for program in programs:
        canonical_gauge(root, program)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--program', action='append', choices=['rpc', 'rpg'])
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    programs = args.program or [['rpc', 'rpg'][0]]
    if args.output:
        run(args.output.resolve(), programs)
    else:
        with tempfile.TemporaryDirectory(prefix='canonicalinitialgaugetest-') as directory:
            run(Path(directory), programs)
