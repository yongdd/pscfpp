#!/usr/bin/env python3
"""Preserve complete input files while editing records or rejecting an edit."""

import argparse
from pathlib import Path
import tempfile
import unittest

from pscfpp.command import Script
from pscfpp.text import RecordEditor


class RecordEditorTransactionTest(unittest.TestCase):
    def edit(self, path, dry=False, filter_field=0):
        editor = RecordEditor()
        editor.setFilter('WRITE_THERMO', filter_field)
        editor.setNew('new.dat', 1)
        editor.setIsTest(dry)
        editor.editFile(str(path))

    def test_blank_records_preserve_commands(self):
        for index, blank in enumerate(['\n', '  \t  \n']):
            with self.subTest(blank=repr(blank)):
                path = OUTPUT / ('blank-%d' % index)
                text = ('READ_W_BASIS in/w.bf\n' + blank
                        + 'WRITE_THERMO old.dat\nFINISH\n')
                path.write_text(text)
                self.assertEqual(len(Script(str(path))), 3)
                self.edit(path)
                self.assertEqual(path.read_text(), text.replace('old.dat', 'new.dat'))
                commands = Script(str(path))
                self.assertEqual(len(commands), 3)
                self.assertEqual(commands['WRITE_THERMO'].param(), 'new.dat')
                self.assertEqual(commands[2].label, 'FINISH')

    def test_normal_and_repeated_edits(self):
        path = OUTPUT / 'ordinary'
        text = ('READ_W_BASIS in/w.bf\nWRITE_THERMO old.dat\n'
                'WRITE_THERMO old.dat\nFINISH\n')
        path.write_text(text)
        self.edit(path)
        self.assertEqual(path.read_text(), text.replace('old.dat', 'new.dat'))

    def test_invalid_late_record_preserves_original(self):
        path = OUTPUT / 'invalid-record'
        text = ('WRITE_THERMO old.dat\n\nREAD_W_BASIS in/w.bf\n'
                'WRITE_THERMO\nFINISH\n')
        path.write_text(text)
        with self.assertRaises(IndexError):
            self.edit(path)
        self.assertEqual(path.read_text(), text)

    def test_invalid_filter_index_preserves_original(self):
        path = OUTPUT / 'invalid-index'
        text = 'READ_W_BASIS in/w.bf\nFINISH\n'
        path.write_text(text)
        with self.assertRaises(IndexError):
            self.edit(path, filter_field=5)
        self.assertEqual(path.read_text(), text)

    def test_dry_run_preserves_original(self):
        path = OUTPUT / 'dry-run'
        text = 'READ_W_BASIS in/w.bf\n\nWRITE_THERMO old.dat\nFINISH\n'
        path.write_text(text)
        self.edit(path, dry=True)
        self.assertEqual(path.read_text(), text)

    def test_empty_and_blank_files(self):
        for index, text in enumerate(['', '\n', ' \t\n\n']):
            with self.subTest(text=repr(text)):
                path = OUTPUT / ('empty-%d' % index)
                path.write_text(text)
                self.edit(path)
                self.assertEqual(path.read_text(), text)


def run(folder):
    global OUTPUT
    OUTPUT = folder
    OUTPUT.mkdir(parents=True, exist_ok=True)
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(RecordEditorTransactionTest)
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    if args.output:
        raise SystemExit(run(args.output.resolve()))
    with tempfile.TemporaryDirectory(prefix='record-editor-transaction-') as directory:
        raise SystemExit(run(Path(directory)))
