#!/usr/bin/env python3
import argparse


import math


from pathlib import Path


import re


import shutil


import subprocess


import tempfile


SOURCE = Path(__file__).resolve().parents[5]


def execute(root, name, program, param, files, command):
    work = root / name
    work.mkdir()
    (work / 'param').write_text(param)
    (work / 'command').write_text(command)
    for filename, contents in files.items():
        (work / filename).write_text(contents)
    exe = shutil.which('pscf_' + program)
    if exe is None:
        exe = str(SOURCE / 'bin' / ('pscf_' + program))
    args = [exe] + ([] if program == '1d' else ['-d', '1'])
    args += ['-p', 'param', '-c', 'command']
    result = subprocess.run(args, cwd=work, capture_output=True, text=True,
                            timeout=60)
    log = result.stdout + result.stderr
    (work / 'log').write_text(log)
    return work, result.returncode, log


def fts_chi_scale(root, program):
    for simulator in ['BdSimulator', 'McSimulator']:
        for n in [1., 1e10]:
            chi = 10/n
            param = '''System{
Mixture{ nMonomer 2 monomers[ %.17g %.17g ] nPolymer 1
 Polymer{ type linear nBlock 2 blocks[ 0 %.17g 1 %.17g ] phi 1 }
 vMonomer %.17g ds %.17g }
Interaction{ chi( 0 1 %.17g ) }
Domain{ mesh 8 lattice lamellar }
%s{ AnalyzerManager{ baseInterval 1
 HamiltonianAnalyzer{ interval 1 outputFileName energy nSamplePerOutput 1 }
} }
}
''' % (1/math.sqrt(n), 1/math.sqrt(n), n/2, n/2, 1/n, n/20, chi, simulator)
            trajectory = ('format 1 0\ndim\n1\ncrystal_system\nlamellar\n'
                          'N_cell_param\n1\ncell_param\n1\nN_monomer\n2\n\n')
            for frame in range(2):
                trajectory += 'i = %d\nmesh\n8\n' % frame
                trajectory += ('%.17g %.17g\n' % (chi/2, chi/2))*8 + '\n'
            name = '%s_%s_chi_scale_%g' % (program, simulator, n)
            work, rc, log = execute(root, name, program, param,
                {'trajectory': trajectory},
                'ANALYZE 0 1 RGridTrajectoryReader trajectory\nFINISH\n')
            assert rc == 0, (name, rc, log[-1000:])
            values = {line.split()[0]: float(line.split()[1]) for line in
                      (work/'energy.ave').read_text().splitlines() if line.strip()}
            for key, exact in [('ideal', -1.), ('field', 2.5), ('total', 1.5)]:
                assert abs(values[key]-exact) < 1e-7, (name, key, values)
    print(program + ': BD/MC Hamiltonian is invariant under contour-unit scaling')


def run(root, programs):
    root.mkdir(parents=True, exist_ok=True)
    for program in programs:
        fts_chi_scale(root, program)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--program', action='append', choices=['rpc', 'rpg'])
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    programs = args.program or [['rpc', 'rpg'][0]]
    if args.output:
        run(args.output.resolve(), programs)
    else:
        with tempfile.TemporaryDirectory(prefix='ftshamiltonianscalingtest-') as directory:
            run(Path(directory), programs)
